const FormRenderer = ({ formData = {}, formKey, commonFields, images }: any) => {
  return (
    <div className="space-y-12 bg-gray-100 py-8 flex flex-col items-center">
      <Page1
        formSchema={formSchema}
        formData={formData}
        commonFields={commonFields}
        images={images}
      />
      <Page2
        formSchema={formSchema}
        formData={formData}
        commonFields={commonFields}
        images={images}
      />
      <Page3
        formSchema={formSchema}
        formData={formData}
        commonFields={commonFields}
