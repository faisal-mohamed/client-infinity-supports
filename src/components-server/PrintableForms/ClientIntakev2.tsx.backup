// ✅ Shared for all pages
const commonFieldMapping: Record<string, string> = {
  givenName: "name",
  dateOfBirth: "dob",
  ndisNumber: "ndis",
  sex: "sex",
  addressNumberStreet: "street",
  state: "state",
  postcode: "postCode",
  homePhone: "phone",
  email: "email",
  disabilityConditions: "disability",
};

// Helper function to check if a field is a common field
const isCommonField = (fieldKey: string): boolean => {
  return Object.keys(commonFieldMapping).includes(fieldKey);
};

// Helper function to get the appropriate value (from commonFields or formData)
const getFieldValue = (
  key: string,
  formData: Record<string, any>,
  commonFields: Record<string, any>
) => {
  return key in commonFieldMapping
    ? commonFields?.[commonFieldMapping[key]] ?? ""
    : formData?.[key] ?? "";
};

function getTodayDateFormatted() {
  const today = new Date();
  const day = String(today.getDate()).padStart(2, "0");
  const month = String(today.getMonth() + 1).padStart(2, "0");
  const year = today.getFullYear();
  return `${day}/${month}/${year}`;
}

const Page1 = ({ formSchema, formData = {}, commonFields = {}, images }: any) => {
  const pageSchema = formSchema.schema.clientIntakeSchema;
  const displayCheckboxGroup = (options: any, selected: any[] = [], otherValue: any = "") => (
    <div className="space-y-1 text-xs">
      {options.map((opt: any) => (
        <div key={opt} className="flex items-center space-x-1">
          <span className="w-3 h-3 border border-black flex justify-center items-center text-[8px]">
            {selected?.includes(opt) ? "✔" : ""}
          </span>
          <span className="text-xs">{opt}</span>
        </div>
      ))}
      {otherValue && (
        <div className="flex items-center space-x-1">
          <span className="w-3 h-3 border border-black flex justify-center items-center text-[8px]">✔</span>
          <span className="text-xs">{otherValue}</span>
        </div>
      )}
    </div>
  );

  return (
    <div
      className="bg-white mx-auto shadow-md"
      style={{
        width: "794px",  // A4 width in px
        height: "1123px", // A4 height in px
        boxShadow: "0 0 10px rgba(0,0,0,0.1)",
        pageBreakAfter: "always",
        margin: 0,
        padding: 0,
        display: "flex",
        flexDirection: "column",
      }}
    >
      {/* Header - Fixed height */}
      <div className="flex justify-center py-3" style={{ height: "80px", flexShrink: 0 }}>
        <img
          alt={pageSchema.logo.alt}
          src={images?.infinityLogo || pageSchema.logo.src}
          width={pageSchema.logo.width}
          height={pageSchema.logo.height}
          className="object-contain"
        />
      </div>
      
      {/* Content - Flexible height */}
      <div className="px-6" style={{ flex: 1, display: "flex", flexDirection: "column" }}>
        <table className="w-full border-collapse border border-black text-xs" style={{ flex: 1, height: "100%" }}>
          <thead>
            <tr>
              <th className="border border-black font-bold text-center py-2" colSpan={3} style={{ height: "40px" }}>
                {pageSchema.pageTitle}
              </th>
            </tr>
          </thead>
          <tbody>
            {pageSchema.fields.map((field: any, idx: any) => {
              const value = getFieldValue(field.key, formData, commonFields);
              if (field.type === "sectionHeader") {
                return (
                  <tr key={idx} className="bg-gray-300 font-semibold text-xs">
                    <td className="border border-black px-2 py-1" colSpan={field.colSpan || 3} style={{ height: "30px" }}>
                      {field.label}
                    </td>
                  </tr>
                );
              }
              if (field.type === "textarea") {
                return (
                  <tr key={idx}>
                    <td
                      className="border border-black px-2 py-1 align-top text-xs"
                      colSpan={field.colSpan || 3}
                      style={{ height: "120px", verticalAlign: "top" }}
                    >
                      {value || ""}
                    </td>
                  </tr>
                );
              }
              if (field.type === "checkboxGroup") {
                return (
                  <tr key={idx}>
                    <td
                      className="border border-black px-2 py-1 font-semibold align-top text-xs"
                      style={{ width: field.width || "30%", height: "60px", verticalAlign: "top" }}
                      colSpan={field.colSpan || 1}
                    >
                      {field.label}
                    </td>
                    <td className="border border-black px-2 py-1 align-top" colSpan={field.colSpan ? field.colSpan - 1 : 2} style={{ height: "60px", verticalAlign: "top" }}>
                      {displayCheckboxGroup(
                        field.options,
                        value,
                        field.otherKey ? getFieldValue(field.otherKey, formData, commonFields) : ""
                      )}
                    </td>
                  </tr>
                );
              }
              return (
                <tr key={idx}>
                  <td className="border border-black px-2 py-1 font-semibold text-xs" style={{ width: field.width || "30%", height: "35px" }}>
                    {field.label}
                  </td>
                  <td className="border border-black px-2 py-1 text-xs" colSpan={field.colSpan || 2} style={{ height: "35px" }}>
                    {value || ""}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      
      {/* Footer - Fixed height */}
      {pageSchema.footer && (
        <div className="flex justify-between text-[10px] text-gray-600 px-6 py-2" style={{ height: "30px", flexShrink: 0 }}>
          <div>Website: infinitysupportswa.org</div>
          <div>CF001</div>
          <div>Review Date: {getTodayDateFormatted()}</div>
        </div>
      )}
    </div>
  );
};

const Page2 = ({ formSchema, formData = {}, commonFields = {}, images }: any) => {
  const pageSchema = formSchema.schema.gpMedicalSupportSchema;
  const displayCheckboxGroup = (options: any, selected: any[] = [], otherValue = "") => (
    <div className="space-y-1 text-xs">
      {options.map((opt: any) => (
        <div key={opt} className="flex items-center space-x-1">
          <span className="w-3 h-3 border border-black flex justify-center items-center text-[8px]">
            {selected?.includes(opt) ? "✔" : ""}
          </span>
          <span className="text-xs">{opt}</span>
        </div>
      ))}
      {otherValue && (
        <div className="flex items-center space-x-1">
          <span className="w-3 h-3 border border-black flex justify-center items-center text-[8px]">✔</span>
          <span className="text-xs">{otherValue}</span>
        </div>
      )}
    </div>
  );

  return (
    <div
      className="bg-white mx-auto shadow-md"
      style={{
        width: "794px",  // A4 width in px
        height: "1123px", // A4 height in px
        boxShadow: "0 0 10px rgba(0,0,0,0.1)",
        pageBreakAfter: "always",
        margin: 0,
        padding: 0,
        display: "flex",
        flexDirection: "column",
      }}
    >
      {/* Header - Fixed height */}
      <div className="flex justify-center py-3" style={{ height: "80px", flexShrink: 0 }}>
        <img
          alt={pageSchema.logo.alt}
          height={pageSchema.logo.height}
          src={images?.infinityLogo || pageSchema.logo.src}
          width={pageSchema.logo.width}
          className="object-contain"
        />
      </div>
      
      {/* Content - Flexible height */}
      <div className="px-6" style={{ flex: 1, display: "flex", flexDirection: "column" }}>
        <table className="w-full border-collapse border border-black text-sm" style={{ flex: 1, height: "100%" }}>
          <tbody>
            {pageSchema.fields.map((field: any, idx: any) => {
              const value = getFieldValue(field.key, formData, commonFields);
              if (field.type === "sectionHeader") {
                return (
                  <tr key={idx} className={`${field.bgColor || "bg-gray-300"} font-bold text-sm`}>
                    <td className="border border-black px-3 py-2" colSpan={field.colSpan || 2} style={{ height: "40px" }}>
                      {field.label}
                    </td>
                  </tr>
                );
              }
              if (field.type === "textarea") {
                return (
                  <tr key={idx}>
                    <td
                      className="border border-black align-top p-3 text-sm"
                      colSpan={field.colSpan || 2}
                      style={{ height: "200px", verticalAlign: "top" }}
                    >
                      {value || ""}
                    </td>
                  </tr>
                );
              }
              if (field.type === "checkboxGroup") {
                return (
                  <tr key={idx}>
                    <td
                      className="border border-black px-3 py-2 font-semibold text-sm align-top"
                      style={{ width: field.width || "50%", height: "50px", verticalAlign: "top" }}
                      colSpan={field.colSpan || 1}
                    >
                      {field.label}
                    </td>
                    <td className="border border-black px-3 py-2 align-top" style={{ height: "50px", verticalAlign: "top" }}>
                      {displayCheckboxGroup(
                        field.options,
                        value,
                        field.otherKey ? getFieldValue(field.otherKey, formData, commonFields) : ""
                      )}
                    </td>
                  </tr>
                );
              }
              if (field.type === "text") {
                return (
                  <tr key={idx}>
                    <td className="border border-black px-3 py-2 font-semibold text-sm" style={{ width: field.width || "50%", height: "45px" }}>
                      {field.label}
                    </td>
                    <td className="border border-black px-3 py-2 text-sm" style={{ height: "45px" }}>
                      {value || ""}
                    </td>
                  </tr>
                );
              }
              return null;
            })}
          </tbody>
        </table>
      </div>
      
      {/* Footer - Fixed height */}
      {pageSchema.footer && (
        <div className="flex justify-between text-[10px] text-gray-600 px-6 py-2" style={{ height: "30px", flexShrink: 0 }}>
          <div>Website: infinitysupportswa.org</div>
          <div>CF001</div>
          <div>Review Date: {getTodayDateFormatted()}</div>
        </div>
      )}
    </div>
  );
};

const Page3 = ({ formSchema, formData = {}, commonFields = {}, images }: any) => {
  const pageSchema = formSchema.schema.allAboutMeSchema;
  const renderPersonalSituation = (psSchema: any, flatData: any) => (
    <div className="space-y-1 text-xs">
      <div className="mb-2">
        <span className="font-bold text-xs">{psSchema.barriers.label}</span>
        <span className="ml-1 mr-1 w-3 h-3 border border-black inline-flex items-center justify-center text-[8px]">
          {flatData?.barriers === "Yes" ? "✔" : ""}
        </span>
        <span className="text-xs">{psSchema.barriers.options[0]}</span>
        <span className="ml-1 mr-1 w-3 h-3 border border-black inline-flex items-center justify-center text-[8px]">
          {flatData?.barriers === "No" ? "✔" : ""}
        </span>
        <span className="text-xs">{psSchema.barriers.options[1]}</span>
        <span className="ml-2 text-xs">{psSchema.barriers.followUp}</span>
      </div>
      <div className="mb-1">
        <span className="text-xs">{psSchema.interpreter.label}</span>
        <span className="ml-1 mr-1 w-3 h-3 border border-black inline-flex items-center justify-center text-[8px]">
          {flatData?.interpreter === "Yes" ? "✔" : ""}
        </span>
        <span className="text-xs">{psSchema.interpreter.options[0]}</span>
        <span className="ml-1 mr-1 w-3 h-3 border border-black inline-flex items-center justify-center text-[8px]">
          {flatData?.interpreter === "No" ? "✔" : ""}
        </span>
        <span className="text-xs">{psSchema.interpreter.options[1]}</span>
      </div>
      <div className="text-xs">{psSchema.language.label} {flatData?.language || ""}</div>
      <div className="text-xs">{psSchema.culturalValues.label} {flatData?.culturalValues || ""}</div>
      <div className="text-xs">{psSchema.culturalBehaviours.label} {flatData?.culturalBehaviours || ""}</div>
      <div className="text-xs">{psSchema.writtenCommunication.label} {flatData?.writtenCommunication || ""}</div>
      <div className="text-xs">{psSchema.countryOfBirth.label} {flatData?.countryOfBirth || ""}</div>
    </div>
  );

  return (
    <div
      className="bg-white mx-auto shadow-md"
      style={{
        width: "794px",  // A4 width in px
        height: "1123px", // A4 height in px
        boxShadow: "0 0 10px rgba(0,0,0,0.1)",
        pageBreakAfter: "always",
        margin: 0,
        padding: 0,
        display: "flex",
        flexDirection: "column",
      }}
    >
      {/* Header - Fixed height */}
      <div className="flex justify-center py-3" style={{ height: "80px", flexShrink: 0 }}>
        <img
          alt={pageSchema.logo.alt}
          height={pageSchema.logo.height}
          src={images?.infinityLogo || pageSchema.logo.src}
          width={pageSchema.logo.width}
          className="object-contain"
        />
      </div>
      
      {/* Content - Flexible height */}
      <div className="px-6" style={{ flex: 1, display: "flex", flexDirection: "column" }}>
        <table className="w-full border border-black border-collapse text-xs" style={{ flex: 1, height: "100%" }}>
          <tbody>
            <tr>
              <th className="border border-black text-left font-bold text-xs px-2 py-2 bg-gray-300" colSpan={2} style={{ height: "35px" }}>
                {pageSchema.sections.allAboutMe.title}
              </th>
            </tr>
            <tr>
              <td className="border border-black align-top px-2 py-2 text-xs" colSpan={2} style={{ height: "120px", verticalAlign: "top" }}>
                {getFieldValue("allAboutMe", formData, commonFields)}
              </td>
            </tr>
            <tr>
              <th className="border border-black text-left font-bold text-xs px-2 py-2 bg-gray-300" colSpan={2} style={{ height: "35px" }}>
                {pageSchema.sections.advocateDetails.title}
              </th>
            </tr>
            <tr>
              <td className="border border-black text-xs px-2 py-1" style={{ height: "30px" }}>
                {pageSchema.sections.advocateDetails.fields.name} {getFieldValue("advocateName", formData, commonFields)}
              </td>
              <td className="border border-black text-xs px-2 py-1" style={{ height: "30px" }}>
                {pageSchema.sections.advocateDetails.fields.relationship} {getFieldValue("advocateRelationship", formData, commonFields)}
              </td>
            </tr>
            <tr>
              <td className="border border-black text-xs px-2 py-1" style={{ height: "30px" }}>
                {pageSchema.sections.advocateDetails.fields.phone} {getFieldValue("advocatePhone", formData, commonFields)}
              </td>
              <td className="border border-black text-xs px-2 py-1" style={{ height: "30px" }}>
                {pageSchema.sections.advocateDetails.fields.mobile} {getFieldValue("advocateMobile", formData, commonFields)}
                <br />
                {pageSchema.sections.advocateDetails.fields.email} {getFieldValue("advocateEmail", formData, commonFields)}
              </td>
            </tr>
            <tr>
              <td className="border border-black text-xs px-2 py-1" colSpan={2} style={{ height: "30px" }}>
                {pageSchema.sections.advocateDetails.fields.address} {getFieldValue("advocateAddress", formData, commonFields)}
              </td>
            </tr>
            <tr>
              <td className="border border-black text-xs px-2 py-1" colSpan={2} style={{ height: "30px" }}>
                {pageSchema.sections.advocateDetails.fields.postalAddress} {getFieldValue("advocatePostalAddress", formData, commonFields)}
              </td>
            </tr>
            <tr>
              <td className="border border-black text-xs px-2 py-1" colSpan={2} style={{ height: "30px" }}>
                {pageSchema.sections.advocateDetails.fields.otherInfo} {getFieldValue("advocateOtherInfo", formData, commonFields)}
              </td>
            </tr>
            <tr>
              <th className="border border-black text-left font-bold text-xs px-2 py-2 bg-gray-300" colSpan={2} style={{ height: "35px" }}>
                {pageSchema.sections.personalSituation.title}
              </th>
            </tr>
            <tr>
              <td className="border border-black text-xs px-2 py-2 align-top" colSpan={2} style={{ height: "200px", verticalAlign: "top" }}>
                {renderPersonalSituation(pageSchema.sections.personalSituation.fields, getFieldValue("personalSituation", formData, commonFields) || {})}
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      
      {/* Footer - Fixed height */}
      <div className="flex justify-between text-[10px] text-gray-600 px-6 py-2" style={{ height: "30px", flexShrink: 0 }}>
        <div>Website: infinitysupportswa.org</div>
        <div>CF001</div>
        <div>Review Date: {getTodayDateFormatted()}</div>
      </div>
    </div>
  );
};

const Page4 = ({ formSchema, formData = {}, commonFields = {}, images }: any) => {
  const pageSchema = formSchema.schema.contactsLivingTravelSchema;
  const renderCheckboxList = (options: any, selected: any, otherValue: any) => (
    <ul className="list-none ml-2 space-y-1">
      {options.map((opt: any) => (
        <li key={opt} className="flex items-center space-x-1">
          <span className="w-3 h-3 border border-black flex items-center justify-center text-[8px] flex-shrink-0">
            {selected?.includes(opt) ? "✔" : ""}
          </span>
          <span className="text-xs">{opt === "Other" ? "Other:" : opt}</span>
          {opt === "Other" && otherValue && (
            <span className="border-b border-black flex-grow min-w-[40px] ml-1 text-xs">
              {otherValue}
            </span>
          )}
        </li>
      ))}
    </ul>
  );

  return (
    <div
      className="bg-white mx-auto shadow-md"
      style={{
        width: "794px",  // A4 width in px
        height: "1123px", // A4 height in px
        boxShadow: "0 0 10px rgba(0,0,0,0.1)",
        pageBreakAfter: "always",
        margin: 0,
        padding: 0,
        display: "flex",
        flexDirection: "column",
      }}
    >
      {/* Header - Fixed height */}
      <div className="flex justify-center py-3" style={{ height: "80px", flexShrink: 0 }}>
        <img
          alt={pageSchema.logo?.alt || "Logo"}
          height={pageSchema.logo?.height || 80}
          src={images?.infinityLogo || pageSchema.logo?.src}
          width={pageSchema.logo?.width || 200}
          className="object-contain"
        />
      </div>
      
      {/* Content - Flexible height */}
      <div className="px-6" style={{ flex: 1, display: "flex", flexDirection: "column" }}>
        <table className="w-full border border-black border-collapse text-sm" style={{ flex: 1, height: "100%" }}>
          <tbody>
            {pageSchema.fields?.map((field: any, idx: number) => {
              if (field.type === "contactHeader") {
                return (
                  <tr key={idx} className="bg-gray-300 font-bold text-sm">
                    <td className="border border-black px-3 py-2" style={{ width: "33.33%", height: "35px" }}>{field.label}</td>
                    <td className="border border-black px-3 py-2" style={{ width: "33.33%", height: "35px" }}></td>
                    <td className="border border-black px-3 py-2" style={{ width: "33.33%", height: "35px" }}></td>
                  </tr>
                );
              }
              if (field.type === "contactRow") {
                return (
                  <tr key={idx}>
                    <td className="border border-black px-3 py-2 text-sm" style={{ height: "40px" }}>
                      {field.columns[0].label} {getFieldValue(field.columns[0].key, formData, commonFields) || ""}
                    </td>
                    <td className="border border-black px-3 py-2" style={{ height: "40px" }}></td>
                    <td className="border border-black px-3 py-2 text-sm" style={{ height: "40px" }}>
                      {field.columns[1].label} {getFieldValue(field.columns[1].key, formData, commonFields) || ""}
                    </td>
                  </tr>
                );
              }
              if (field.type === "boxSection") {
                return (
                  <tr key={idx}>
                    <td className="border border-black p-4 text-sm align-top" colSpan={3} style={{ height: "300px", verticalAlign: "top" }}>
                      <p className="font-bold mb-2 text-sm">{field.heading}</p>
                      <p className="mb-3 text-sm">{field.question}</p>
                      {renderCheckboxList(
                        field.options,
                        getFieldValue(field.key, formData, commonFields) || [],
                        getFieldValue(field.otherKey, formData, commonFields) || ""
                      )}
                    </td>
                  </tr>
                );
              }
              return null;
            })}
          </tbody>
        </table>
      </div>
      
      {/* Footer - Fixed height */}
      {pageSchema.footer && (
        <div className="flex justify-between text-[10px] text-gray-600 px-6 py-2" style={{ height: "30px", flexShrink: 0 }}>
          <div>Website: infinitysupportswa.org</div>
          <div>CF001</div>
          <div>Review Date: {getTodayDateFormatted()}</div>
        </div>
      )}
    </div>
  );
};

const Page5 = ({ formSchema, formData = {}, commonFields = {}, images }: any) => {
  const pageSchema = formSchema.schema.medicationInfoSchema;
  return (
    <div
      className="bg-white mx-auto shadow-md"
      style={{
        width: "794px",  // A4 width in px
        height: "1123px", // A4 height in px
        boxShadow: "0 0 10px rgba(0,0,0,0.1)",
        pageBreakAfter: "always",
        margin: 0,
        padding: 0,
        display: "flex",
        flexDirection: "column",
      }}
    >
      {/* Header - Fixed height */}
      <div className="flex justify-center py-3" style={{ height: "80px", flexShrink: 0 }}>
        <img
          alt={pageSchema.logo.alt}
          src={images?.infinityLogo || pageSchema.logo.src}
          width={pageSchema.logo.width}
          height={pageSchema.logo.height}
          className="object-contain"
        />
      </div>
      
      {/* Content - Flexible height */}
      <div className="px-6" style={{ flex: 1, display: "flex", flexDirection: "column" }}>
        <table className="w-full border border-black border-collapse text-sm" style={{ flex: 1, height: "100%" }}>
          <thead>
            <tr className="bg-gray-300">
              <th className="border border-black p-2 text-left font-semibold text-sm" style={{ width: "50%", height: "40px" }}>
                {pageSchema.title}
              </th>
              <th className="border border-black p-2 text-left font-semibold text-sm" style={{ width: "35%", height: "40px" }}>Yes</th>
              <th className="border border-black p-2 text-center font-semibold text-sm" style={{ width: "15%", height: "40px" }}>No</th>
            </tr>
          </thead>
          <tbody>
            {pageSchema.fields.map((field: any, idx: any) => {
              const value = getFieldValue(field.key, formData, commonFields);
              const rowHeight = field.yesDetail ? "70px" : "50px";
              return (
                <tr key={idx}>
                  <td className="border border-black p-2 align-top text-sm" style={{ height: rowHeight, verticalAlign: "top" }}>
                    {field.label}
                  </td>
                  <td className="border border-black p-2 align-top text-xs" style={{ height: rowHeight, verticalAlign: "top" }}>
                    <div className="inline-flex items-start space-x-1">
                      <span className="w-3 h-3 border border-black flex justify-center items-center text-[8px] mt-0.5">
                        {value === "Yes" ? "✔" : ""}
                      </span>
                      <span className="text-xs">Yes</span>
                    </div>
                    {field.yesDetail && (
                      <div className="mt-1 text-[10px] leading-tight text-gray-700">
                        {field.yesDetail}
                      </div>
                    )}
                    {value === "Yes" && getFieldValue(`${field.key}Others`, formData, commonFields) && (
                      <div className="mt-1 text-[10px] text-gray-800 italic leading-tight">
                        {getFieldValue(`${field.key}Others`, formData, commonFields)}
                      </div>
                    )}
                  </td>
                  <td className="border border-black p-2 text-center align-top" style={{ height: rowHeight, verticalAlign: "top" }}>
                    <span className="w-3 h-3 border border-black flex justify-center items-center text-[8px] mx-auto mt-0.5">
                      {value === "No" ? "✔" : ""}
                    </span>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      
      {/* Footer - Fixed height */}
      <div className="flex justify-between text-[10px] text-gray-600 px-6 py-2" style={{ height: "30px", flexShrink: 0 }}>
        <div>Website: infinitysupportswa.org</div>
        <div>CF001</div>
        <div>Review Date: {getTodayDateFormatted()}</div>
      </div>
    </div>
  );
};

