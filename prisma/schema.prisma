generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id                          Int                           @id @default(autoincrement())
  name                        String
  email                       String                        @unique(map: "Admin_email_unique")
  passwordHash                String
  resetToken                  String?
  resetTokenExpiry            DateTime?
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  clients                     Client[]
  logs                        FormActivityLog[]
  assignedFormAssignments     FormAssignment[]              @relation("AssignedForms")
  notifications               FormSubmissionNotification[]
  Staff                       Staff[]
  StaffActivityLog            StaffActivityLog[]
  StaffFormAssignment         StaffFormAssignment[]
  StaffSubmissionNotification StaffSubmissionNotification[]
  appSettings                 AppSettings[]
  mfaCodes                    MfaCode[]
}

model Client {
  id             Int                          @id @default(autoincrement())
  name           String?
  email          String?
  phone          String?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  createdById    Int?
  archivedAt     DateTime?
  archivedBy     Int?
  createdBy      Admin?                       @relation(fields: [createdById], references: [id])
  commonFields   CommonField?
  logs           FormActivityLog[]
  FormAssignment FormAssignment[]
  formBatches    FormBatch[]
  progress       FormProgress[]
  forms          FormSubmission[]
  notifications  FormSubmissionNotification[]
  insights       Insight[]

  @@index([archivedAt])
}

model MasterForm {
  id                  Int                   @id @default(autoincrement())
  formKey             String                @unique
  title               String
  version             Int
  schema              Json?
  requiresSignature   Boolean?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  FormAssignment      FormAssignment[]
  formProgress        FormProgress[]
  formSubmissions     FormSubmission[]
  StaffFormAssignment StaffFormAssignment[]
  StaffFormProgress   StaffFormProgress[]
  StaffFormSubmission StaffFormSubmission[]

  @@unique([formKey, version])
}

model FormBatch {
  id              Int                  @id @default(autoincrement())
  clientId        Int
  batchToken      String               @unique
  passcode        String?
  expiresAt       DateTime
  createdAt       DateTime             @default(now())
  isSignatureOnly Boolean              @default(false)
  isCompleted     Boolean              @default(false)
  completedAt     DateTime?
  adminNotified   Boolean              @default(false)
  assignments     FormAssignment[]
  client          Client               @relation(fields: [clientId], references: [id])
  signatureForms  SignatureBatchForm[]
}

model FormAssignment {
  id                      Int        @id @default(autoincrement())
  clientId                Int
  formId                  Int
  formVersion             Int
  assignedAt              DateTime   @default(now())
  currentStatus           String     @default("not_started")
  isCompleted             Boolean    @default(false)
  isCommonFieldsCompleted Boolean    @default(false)
  displayOrder            Int        @default(0)
  batchId                 Int
  assignedById            Int?
  archivedAt              DateTime?
  archivedBy              Int?
  assignedBy              Admin?     @relation("AssignedForms", fields: [assignedById], references: [id])
  batch                   FormBatch  @relation(fields: [batchId], references: [id])
  client                  Client     @relation(fields: [clientId], references: [id])
  form                    MasterForm @relation(fields: [formId], references: [id])

  instanceNumber          Int        @default(1)

  @@unique([clientId, formId, formVersion, instanceNumber])
  @@index([archivedAt])
}

model FormSubmission {
  id               Int                          @id @default(autoincrement())
  clientId         Int
  formId           Int
  formVersion      Int
  data             Json
  isSubmitted      Boolean                      @default(false)
  submittedAt      DateTime?
  updatedAt        DateTime                     @updatedAt
  filledByAdmin    Boolean                      @default(false)
  adminFilledAt    DateTime?
  clientSignature  String?
  clientSignedAt   DateTime?
  client           Client                       @relation(fields: [clientId], references: [id])
  form             MasterForm                   @relation(fields: [formId], references: [id])
  notifications    FormSubmissionNotification[]
  signatureBatches SignatureBatchForm[]

  instanceNumber   Int                          @default(1)

  @@unique([clientId, formId, formVersion, instanceNumber])
}

model FormProgress {
  id             Int        @id @default(autoincrement())
  clientId       Int
  formId         Int
  formVersion    Int
  currentSection String?
  updatedAt      DateTime   @updatedAt
  client         Client     @relation(fields: [clientId], references: [id])
  form           MasterForm @relation(fields: [formId], references: [id])

  @@unique([clientId, formId, formVersion])
}

model CommonField {
  id         Int      @id @default(autoincrement())
  clientId   Int      @unique
  name       String?
  age        Int?
  email      String?
  sex        String?
  street     String?
  state      String?
  postCode   String?
  dob        String?
  ndis       String?
  disability String?
  address    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  phone      String?
  surname    String?
  client     Client   @relation(fields: [clientId], references: [id])
}

model Insight {
  id            Int       @id @default(autoincrement())
  clientId      Int
  age           Int?
  location      String?
  disability    String?
  language      String?
  contractStart DateTime?
  contractEnd   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  client        Client    @relation(fields: [clientId], references: [id])
}

model FormActivityLog {
  id        Int      @id @default(autoincrement())
  clientId  Int?
  adminId   Int?
  logType   LogType
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
  admin     Admin?   @relation(fields: [adminId], references: [id])
  client    Client?  @relation(fields: [clientId], references: [id])

  @@index([clientId, adminId])
}

model SignatureBatchForm {
  id               Int            @id @default(autoincrement())
  batchId          Int
  formSubmissionId Int
  createdAt        DateTime       @default(now())
  batch            FormBatch      @relation(fields: [batchId], references: [id])
  formSubmission   FormSubmission @relation(fields: [formSubmissionId], references: [id])

  @@unique([batchId, formSubmissionId])
}

model AppSettings {
  id           Int      @id @default(autoincrement())
  key          String
  value        String?
  type         String
  category     String
  label        String
  description  String?
  isRequired   Boolean  @default(false)
  defaultValue String?
  validation   String?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  adminId      Int?
  admin        Admin?   @relation(fields: [adminId], references: [id])

  @@unique([key, adminId])
  @@index([category, adminId])
  @@map("app_settings")
}

model FormSubmissionNotification {
  id               Int            @id @default(autoincrement())
  adminId          Int
  clientId         Int
  formSubmissionId Int
  isRead           Boolean        @default(false)
  createdAt        DateTime       @default(now())
  admin            Admin          @relation(fields: [adminId], references: [id])
  client           Client         @relation(fields: [clientId], references: [id])
  formSubmission   FormSubmission @relation(fields: [formSubmissionId], references: [id])

  @@index([adminId, isRead])
  @@index([createdAt])
}

model Staff {
  id                                Int                                @id @default(autoincrement())
  firstName                         String
  surname                           String
  email                             String
  phone                             String?
  role                              String?
  status                            String                             @default("pending")
  startDate                         DateTime?
  linkToken                         String?                            @unique
  linkExpiresAt                     DateTime?
  createdAt                         DateTime                           @default(now())
  updatedAt                         DateTime
  createdById                       Int?
  Admin                             Admin?                             @relation(fields: [createdById], references: [id])
  StaffActivityLog                  StaffActivityLog[]
  StaffBullyingHarassmentTraining   StaffBullyingHarassmentTraining?
  StaffBullyingTraining             StaffBullyingTraining?
  StaffCommonField                  StaffCommonField?
  StaffConflictOfInterest           StaffConflictOfInterest?
  StaffDocumentationAcknowledgement StaffDocumentationAcknowledgement?
  StaffEmploymentDetails            StaffEmploymentDetails?
  StaffEmploymentWelcomeAck         StaffEmploymentWelcomeAck?
  StaffFormAssignment               StaffFormAssignment[]
  StaffFormBatch                    StaffFormBatch[]
  StaffFormDownload                 StaffFormDownload[]
  StaffFormProgress                 StaffFormProgress[]
  StaffFormSubmission               StaffFormSubmission[]
  StaffNdisCodeOfConduct            StaffNdisCodeOfConduct?
  StaffNdisWorkforceCapability      StaffNdisWorkforceCapability?
  StaffPreEmploymentMedical         StaffPreEmploymentMedical?
  StaffSubmissionNotification       StaffSubmissionNotification[]
  StaffSupportWorker                StaffSupportWorker?
  StaffVehicleSafetyInspection      StaffVehicleSafetyInspection?
}

model StaffBullyingHarassmentTraining {
  id             Int       @id @default(autoincrement())
  staffId        Int       @unique
  data           Json
  staffSignature String?
  staffSignedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime
  Staff          Staff     @relation(fields: [staffId], references: [id])
}

model StaffBullyingTraining {
  id             Int       @id @default(autoincrement())
  staffId        Int       @unique
  data           Json
  staffSignature String?
  staffSignedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime
  Staff          Staff     @relation(fields: [staffId], references: [id])
}

model StaffConflictOfInterest {
  id             Int       @id @default(autoincrement())
  staffId        Int       @unique
  data           Json
  staffSignature String?
  staffSignedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime
  Staff          Staff     @relation(fields: [staffId], references: [id])
}

model StaffDocumentationAcknowledgement {
  id             Int       @id @default(autoincrement())
  staffId        Int       @unique
  data           Json
  staffSignature String?
  staffSignedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime
  Staff          Staff     @relation(fields: [staffId], references: [id])
}

model StaffEmploymentDetails {
  id             Int       @id @default(autoincrement())
  staffId        Int       @unique
  data           Json
  staffSignature String?
  staffSignedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime
  status         String?
  adminSignature String?
  adminSignedAt  DateTime?
  Staff          Staff     @relation(fields: [staffId], references: [id])
}

model StaffEmploymentWelcomeAck {
  id             Int       @id @default(autoincrement())
  staffId        Int       @unique
  data           Json
  staffSignature String?
  staffSignedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime
  Staff          Staff     @relation(fields: [staffId], references: [id])
}

model StaffFormSubmission {
  id                          Int                           @id @default(autoincrement())
  staffId                     Int
  formKey                     String?
  data                        Json
  isSubmitted                 Boolean                       @default(false)
  submittedAt                 DateTime?
  updatedAt                   DateTime
  adminFilledAt               DateTime?
  filledByAdmin               Boolean                       @default(false)
  formId                      Int?
  formVersion                 Int?
  staffSignature              String?
  staffSignedAt               DateTime?
  adminSignature              String?
  adminSignedAt               DateTime?
  createdAt                   DateTime                      @default(now())
  MasterForm                  MasterForm?                   @relation(fields: [formId], references: [id])
  Staff                       Staff                         @relation(fields: [staffId], references: [id])
  StaffSignatureBatchForm     StaffSignatureBatchForm[]
  StaffSubmissionNotification StaffSubmissionNotification[]

  @@unique([staffId, formKey])
}

model StaffNdisCodeOfConduct {
  id             Int       @id @default(autoincrement())
  staffId        Int       @unique
  data           Json
  staffSignature String?
  staffSignedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime
  Staff          Staff     @relation(fields: [staffId], references: [id])
}

model StaffNdisWorkforceCapability {
  id             Int       @id @default(autoincrement())
  staffId        Int       @unique
  data           Json
  staffSignature String?
  staffSignedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime
  Staff          Staff     @relation(fields: [staffId], references: [id])
}

model StaffPreEmploymentMedical {
  id             Int       @id @default(autoincrement())
  staffId        Int       @unique
  data           Json
  staffSignature String?
  staffSignedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime
  Staff          Staff     @relation(fields: [staffId], references: [id])
}

model StaffSupportWorker {
  id             Int       @id @default(autoincrement())
  staffId        Int       @unique
  data           Json
  staffSignature String?
  staffSignedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime
  Staff          Staff     @relation(fields: [staffId], references: [id])
}

model StaffActivityLog {
  id        Int      @id @default(autoincrement())
  staffId   Int?
  adminId   Int?
  logType   LogType
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
  Admin     Admin?   @relation(fields: [adminId], references: [id])
  Staff     Staff?   @relation(fields: [staffId], references: [id])

  @@index([staffId, adminId])
}

model StaffCommonField {
  id                    Int      @id @default(autoincrement())
  staffId               Int      @unique
  firstName             String?
  surname               String?
  email                 String?
  phone                 String?
  address               String?
  suburb                String?
  state                 String?
  postcode              String?
  dob                   String?
  emergencyContactName  String?
  emergencyContactPhone String?
  tfn                   String?
  abn                   String?
  superannuation        String?
  bankDetails           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime
  Staff                 Staff    @relation(fields: [staffId], references: [id])
}

model StaffFormAssignment {
  id                      Int            @id @default(autoincrement())
  staffId                 Int
  formId                  Int
  formVersion             Int
  assignedAt              DateTime       @default(now())
  currentStatus           String         @default("not_started")
  isCompleted             Boolean        @default(false)
  isCommonFieldsCompleted Boolean        @default(false)
  displayOrder            Int            @default(0)
  batchId                 Int
  assignedById            Int?
  Admin                   Admin?         @relation(fields: [assignedById], references: [id])
  StaffFormBatch          StaffFormBatch @relation(fields: [batchId], references: [id])
  MasterForm              MasterForm     @relation(fields: [formId], references: [id])
  Staff                   Staff          @relation(fields: [staffId], references: [id])

  @@unique([staffId, formId, formVersion])
}

model StaffFormBatch {
  id                      Int                       @id @default(autoincrement())
  staffId                 Int
  batchToken              String                    @unique
  passcode                String?
  expiresAt               DateTime
  createdAt               DateTime                  @default(now())
  isSignatureOnly         Boolean                   @default(false)
  isCompleted             Boolean                   @default(false)
  completedAt             DateTime?
  adminNotified           Boolean                   @default(false)
  StaffFormAssignment     StaffFormAssignment[]
  Staff                   Staff                     @relation(fields: [staffId], references: [id])
  StaffSignatureBatchForm StaffSignatureBatchForm[]
}

model StaffFormDownload {
  id           Int       @id @default(autoincrement())
  staffId      Int
  formKey      String
  downloadedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
  Staff        Staff     @relation(fields: [staffId], references: [id])

  @@index([staffId])
}

model StaffFormProgress {
  id             Int        @id @default(autoincrement())
  staffId        Int
  formId         Int
  formVersion    Int
  currentSection String?
  updatedAt      DateTime
  MasterForm     MasterForm @relation(fields: [formId], references: [id])
  Staff          Staff      @relation(fields: [staffId], references: [id])

  @@unique([staffId, formId, formVersion])
}

model StaffSignatureBatchForm {
  id                  Int                 @id @default(autoincrement())
  batchId             Int
  formSubmissionId    Int
  createdAt           DateTime            @default(now())
  StaffFormBatch      StaffFormBatch      @relation(fields: [batchId], references: [id])
  StaffFormSubmission StaffFormSubmission @relation(fields: [formSubmissionId], references: [id])

  @@unique([batchId, formSubmissionId])
}

model StaffSubmissionNotification {
  id                  Int                 @id @default(autoincrement())
  adminId             Int
  staffId             Int
  formSubmissionId    Int
  isRead              Boolean             @default(false)
  createdAt           DateTime            @default(now())
  Admin               Admin               @relation(fields: [adminId], references: [id])
  StaffFormSubmission StaffFormSubmission @relation(fields: [formSubmissionId], references: [id])
  Staff               Staff               @relation(fields: [staffId], references: [id])

  @@index([adminId, isRead])
  @@index([createdAt])
}

model StaffVehicleSafetyInspection {
  id             Int       @id @default(autoincrement())
  staffId        Int       @unique
  data           Json
  staffSignature String?
  staffSignedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime
  Staff          Staff     @relation(fields: [staffId], references: [id])
}

model MfaCode {
  id         Int      @id @default(autoincrement())
  adminId    Int
  codeHash   String   // bcrypt hash of the 6-digit OTP
  expiresAt  DateTime
  attempts   Int      @default(0)
  maxAttempts Int     @default(3)
  used       Boolean  @default(false)
  verified   Boolean  @default(false)
  mfaToken   String?  @unique // one-time token issued after successful verification
  tokenExpiresAt DateTime? // mfaToken expiry (60 seconds)
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  admin      Admin    @relation(fields: [adminId], references: [id])

  @@index([adminId, used, expiresAt])
  @@index([mfaToken])
  @@map("mfa_codes")
}

model PIIAccessLog {
  id           Int      @id @default(autoincrement())
  adminId      Int
  clientId     Int
  formId       Int?
  assignmentId Int?
  action       String   // 'reveal' | 'hide'
  accessedAt   DateTime @default(now())
  ipAddress    String?
  userAgent    String?

  @@index([adminId, clientId])
  @@index([accessedAt])
  @@map("pii_access_log")
}

enum LogType {
  CLIENT
  ADMIN
}
