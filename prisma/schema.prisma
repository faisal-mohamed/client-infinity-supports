  downloadedAt DateTime? 
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff Staff @relation(fields: [staffId], references: [id])

  @@index([staffId])
}

model MasterForm {
  id                Int      @id @default(autoincrement())
  formKey           String   @unique
  title             String
  version           Int // Form version (e.g., 1, 2, 3)
  schema            Json? // JSON schema for the form structure (now optional)
  requiresSignature Boolean? // NEW: Optional field to track if form requires signature
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Client relations
  formSubmissions FormSubmission[]
  formProgress   FormProgress[]
  FormAssignment FormAssignment[]

  // NEW: Staff relations
  staffFormSubmissions StaffFormSubmission[]
  staffFormProgress   StaffFormProgress[]
  StaffFormAssignment StaffFormAssignment[]

  // Unique combination of formKey and version
  @@unique([formKey, version])
}

model FormBatch {
  id              Int                  @id @default(autoincrement())
  clientId        Int
  batchToken      String               @unique
  passcode        String?
  expiresAt       DateTime
  createdAt       DateTime             @default(now())
  isSignatureOnly Boolean              @default(false)
  isCompleted     Boolean              @default(false)
  completedAt     DateTime?
  adminNotified   Boolean              @default(false)
  assignments     FormAssignment[]
  client          Client               @relation(fields: [clientId], references: [id])
  signatureForms  SignatureBatchForm[]
}

model FormAssignment {
  id                      Int        @id @default(autoincrement())
  clientId                Int
  formId                  Int
  formVersion             Int
  assignedAt              DateTime   @default(now())
  currentStatus           String     @default("not_started")
  isCompleted             Boolean    @default(false)
  isCommonFieldsCompleted Boolean    @default(false)
  displayOrder            Int        @default(0)
  batchId                 Int
  assignedById            Int?
  assignedBy              Admin?     @relation("AssignedForms", fields: [assignedById], references: [id])
  batch                   FormBatch  @relation(fields: [batchId], references: [id])
  client                  Client     @relation(fields: [clientId], references: [id])
  form                    MasterForm @relation(fields: [formId], references: [id])

  @@unique([clientId, formId, formVersion])
}

model FormSubmission {
  id               Int                          @id @default(autoincrement())
  clientId         Int
  formId           Int
  formVersion      Int
  data             Json
  isSubmitted      Boolean                      @default(false)
  submittedAt      DateTime?
  updatedAt        DateTime                     @updatedAt
  filledByAdmin    Boolean                      @default(false)
  adminFilledAt    DateTime?
  clientSignature  String?
  clientSignedAt   DateTime?
  client           Client                       @relation(fields: [clientId], references: [id])
  form             MasterForm                   @relation(fields: [formId], references: [id])
  notifications    FormSubmissionNotification[]
  signatureBatches SignatureBatchForm[]

  @@unique([clientId, formId, formVersion])
}

model FormProgress {
  id             Int        @id @default(autoincrement())
  clientId       Int
  formId         Int
  formVersion    Int
  currentSection String?
  updatedAt      DateTime   @updatedAt
  client         Client     @relation(fields: [clientId], references: [id])
  form           MasterForm @relation(fields: [formId], references: [id])

  @@unique([clientId, formId, formVersion])
}

model CommonField {
  id         Int      @id @default(autoincrement())
  clientId   Int      @unique
  name       String?
  age        Int?
  email      String?
  sex        String?
  street     String?
  state      String?
  postCode   String?
  dob        String?
  ndis       String?
  disability String?
  address    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  phone      String?
  surname    String?
  client     Client   @relation(fields: [clientId], references: [id])
}

model Insight {
  id            Int       @id @default(autoincrement())
  clientId      Int
  age           Int?
  location      String?
  disability    String?
  language      String?
  contractStart DateTime?
  contractEnd   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  client        Client    @relation(fields: [clientId], references: [id])
}

model FormActivityLog {
  id        Int      @id @default(autoincrement())
  clientId  Int?
  adminId   Int?
  logType   LogType
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
  admin     Admin?   @relation(fields: [adminId], references: [id])
  client    Client?  @relation(fields: [clientId], references: [id])

  @@index([clientId, adminId])
}

model SignatureBatchForm {
  id               Int            @id @default(autoincrement())
  batchId          Int
  formSubmissionId Int
  createdAt        DateTime       @default(now())
  batch            FormBatch      @relation(fields: [batchId], references: [id])
  formSubmission   FormSubmission @relation(fields: [formSubmissionId], references: [id])

  @@unique([batchId, formSubmissionId])
}

model AppSettings {
  id           Int      @id @default(autoincrement())
  key          String
  value        String?
  type         String
  category     String
  label        String
  description  String?
  isRequired   Boolean  @default(false)
  defaultValue String?
  validation   String?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  adminId      Int?
  admin        Admin?   @relation(fields: [adminId], references: [id])

  @@unique([key, adminId])
  @@index([category, adminId])
  @@map("app_settings")
}

model FormSubmissionNotification {
  id               Int            @id @default(autoincrement())
  adminId          Int
  clientId         Int
  formSubmissionId Int
  isRead           Boolean        @default(false)
  createdAt        DateTime       @default(now())
  admin            Admin          @relation(fields: [adminId], references: [id])
  client           Client         @relation(fields: [clientId], references: [id])
  formSubmission   FormSubmission @relation(fields: [formSubmissionId], references: [id])

  @@index([adminId, isRead])
  @@index([createdAt])
}

enum LogType {
  CLIENT
  ADMIN
}
